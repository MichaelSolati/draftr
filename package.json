{
  "name": "draftr-monorepo",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@draftr/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "lint": "run-p lint:*",
    "lint:typescript": "npx tsc -p packages/core/tsconfig.json --noEmit && npx tsc -p apps/web/tsconfig.json --noEmit && npx tsc -p apps/vscode/tsconfig.json --noEmit",
    "lint:gts": "gts lint",
    "fix": "run-p fix:*",
    "fix:gts": "gts fix",
    "dupes": "jscpd packages apps",
    "bump": "bumpp --no-commit --no-tag --no-push -y",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/vsce": "^4.0.0",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "^0.28.2",
    "eslint": "8.57.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "gts": "^5.3.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
