{
  "name": "arch-spec-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "run-p lint:*",
    "lint:typescript": "tsc --noEmit",
    "lint:gts": "gts lint",
    "fix": "run-p fix:*",
    "fix:gts": "gts fix",
    "test": "run-p test:*",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "dupes": "jscpd .",
    "prepare": "husky"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "eslint": "8.57.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "gts": "^5.3.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
