{
  "name": "arch-spec-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@arch-spec/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=@arch-spec/core",
    "coverage": "npm run coverage --workspace=@arch-spec/core",
    "lint": "run-p lint:*",
    "lint:typescript": "npx tsc -p packages/core/tsconfig.json --noEmit && npx tsc -p apps/web/tsconfig.json --noEmit && npx tsc -p apps/vscode/tsconfig.json --noEmit",
    "lint:gts": "gts lint",
    "fix": "run-p fix:*",
    "fix:gts": "gts fix",
    "dupes": "jscpd packages apps",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "8.57.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "gts": "^5.3.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
