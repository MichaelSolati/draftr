{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "draftr",
  "scopeName": "source.draftr",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#polymorphism"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#actions"
    },
    {
      "include": "#http_verbs"
    },
    {
      "include": "#db_modifiers"
    },
    {
      "include": "#methods"
    },
    {
      "include": "#types"
    },
    {
      "include": "#properties"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.draftr",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(abstract\\s+class|class|interface|type|ui|db|api|event|state)\\s+([A-Za-z0-9_$/]+)",
          "captures": {
            "1": { "name": "keyword.control.declaration.draftr" },
            "2": { "name": "entity.name.type.class.draftr" }
          }
        }
      ]
    },
    "polymorphism": {
      "patterns": [
        {
          "match": "\\b(extends|implements)\\b",
          "name": "keyword.control.inheritance.draftr"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "match": "\\b(public|private|protected|readonly|get|set|override)\\b",
          "name": "storage.modifier.draftr"
        },
        {
          "match": "^\\s*([+\\-#])(?=\\s*[A-Za-z0-9_$])",
          "captures": {
            "1": { "name": "storage.modifier.symbol.draftr" }
          }
        }
      ]
    },
    "actions": {
      "patterns": [
        {
          "match": "\\b(binds?|calls|invokes)\\b",
          "name": "keyword.operator.action.draftr"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.draftr"
        }
      ]
    },
    "http_verbs": {
      "patterns": [
        {
          "match": "\\b(GET|POST|PUT|DELETE|PATCH)\\b",
          "name": "keyword.other.http.draftr"
        }
      ]
    },
    "db_modifiers": {
      "patterns": [
        {
          "match": "\\b(pk|fk|unique)\\b",
          "name": "storage.modifier.database.draftr"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(string|number|boolean|any|void|never|unknown|uuid|text|int|serial|timestamp|jsonb)\\b",
          "name": "support.type.primitive.draftr"
        },
        {
          "match": "(?<=:\\s*)([A-Z][A-Za-z0-9_$]*(?:\\.[A-Za-z0-9_$]+)?)",
          "captures": {
            "1": { "name": "entity.name.type.custom.draftr" }
          }
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "match": "([A-Za-z0-9_$]+)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.draftr" }
          }
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "([A-Za-z0-9_$]+)(?=\\s*:)",
          "captures": {
            "1": { "name": "variable.other.property.draftr" }
          }
        }
      ]
    }
  }
}
