{
  "name": "draftr-vscode",
  "displayName": "draftr",
  "description": "Language support, syntax highlighting, and architecture linting for draftr (.draftr) files",
  "version": "0.1.3",
  "publisher": "draftr",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelSolati/draftr.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:draftr"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "draftr",
        "aliases": [
          "draftr"
        ],
        "extensions": [
          ".draftr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "draftr",
        "scopeName": "source.draftr",
        "path": "./syntaxes/draftr.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "draftr.openPreview",
        "title": "Open Architecture Diagram Preview",
        "category": "Draftr",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "draftr.scaffold",
        "title": "Scaffold TypeScript Project",
        "category": "Draftr"
      },
      {
        "command": "draftr.importSql",
        "title": "Import from SQL Schema",
        "category": "Draftr"
      },
      {
        "command": "draftr.importTypeScript",
        "title": "Import from TypeScript Code",
        "category": "Draftr"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "draftr.openPreview",
          "when": "resourceLangId == draftr",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "draftr.openPreview",
          "when": "resourceLangId == draftr"
        },
        {
          "command": "draftr.scaffold",
          "when": "resourceLangId == draftr"
        },
        {
          "command": "draftr.importSql"
        },
        {
          "command": "draftr.importTypeScript"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=esm --platform=node",
    "compile:webview": "esbuild src/webview/client/main.tsx --bundle --outfile=dist/webview.js --format=iife --platform=browser --loader:.css=css",
    "compile": "run-p compile:*",
    "build": "tsc -p ./ && npm run compile",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "package": "vsce package --no-dependencies --skip-license",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@draftr/core": "*",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.80.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
