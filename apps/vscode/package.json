{
  "name": "draftr-vscode",
  "displayName": "draftr",
  "description": "Language support, syntax highlighting, and architecture linting for draftr (.draftr) files",
  "version": "0.1.1",
  "publisher": "draftr",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelSolati/draftr.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:draftr",
    "onLanguage:archspec"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "draftr",
        "aliases": [
          "draftr",
          "archspec"
        ],
        "extensions": [
          ".draftr",
          ".archspec",
          ".arch"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "draftr",
        "scopeName": "source.draftr",
        "path": "./syntaxes/draftr.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=esm --platform=node",
    "build": "tsc -p ./ && npm run compile",
    "package": "vsce package --no-dependencies --skip-license",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@draftr/core": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.6.3"
  }
}
