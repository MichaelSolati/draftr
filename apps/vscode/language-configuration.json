{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(class|interface|type|ui|db|api|event|state)\\s+.*$|^\\s*([+\\-#]|(public|private|protected|readonly|get|set)\\b)?\\s*[A-Za-z0-9_$]+\\s*\\(.*\\).*$",
    "decreaseIndentPattern": "^\\s*(class|interface|type|ui|db|api|event|state)\\s+.*$"
  }
}
