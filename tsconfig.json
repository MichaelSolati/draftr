{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "vitest.config.ts",
    "bump.config.ts",
    "plugins/**/*.js"
  ],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/theme" },
    { "path": "./packages/language-service" },
    { "path": "./apps/web" },
    { "path": "./apps/vscode" }
  ]
}
